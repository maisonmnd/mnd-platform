# Backend Supabase — copier vers `.env.local` (jamais commité) et renseigner.
# Sans ces variables, la plateforme fonctionne entièrement en localStorage.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Paiement en ligne KkiaPay (Ma Couronne). SEULE la clé PUBLIQUE va ici : elle
# part dans le paquet statique, donc elle est lisible par tout le monde — c'est
# son rôle. Les clés privée et secrète ne vivent QUE dans les secrets des
# fonctions Edge `kkiapay-verify` / `kkiapay-webhook`.
# Sans VITE_KKIAPAY_PUBLIC_KEY, l'écran d'acompte reste le mode d'emploi
# Mobile Money : aucun bouton de paiement n'apparaît.
VITE_KKIAPAY_PUBLIC_KEY=
# 'true' = bac à sable (aucun franc réel ne bouge). À retirer en production.
VITE_KKIAPAY_SANDBOX=true
