node_modules/
dist/
*.local
.DS_Store
dist-sites/

# Réglages Claude Code personnels (chemins de la machine, allow-list locale).
# .claude/settings.json et .claude/hooks/ restent versionnés, eux.
.claude/settings.local.json

# Fichiers d'import GÉNÉRÉS — ils portent les données personnelles des clientes
# (noms, téléphones, e-mails, anniversaires). Ce dépôt est PUBLIC : ils n'y
# entrent jamais. Ils se regénèrent d'une commande :
#   node scripts/firestore-export.mjs <clé.json> <export>
#   node scripts/import-genere.mjs <export> <catalogue-v6.json> supabase/import_v6.sql
supabase/import_v6*.sql
supabase/verif_clientes_intruses.sql
supabase/repare_telephones.sql

# LES FORMULES MAÎTRES DE L'ATELIER — secret de fabrique (« usage exclusif
# Brice & Yéman »). Le dépôt est PUBLIC et le bundle JS se télécharge sans
# compte : les formules réelles ne vivent qu'en BASE, sous is_staff(), jamais
# dans le code. Ce fichier les insère ; il ne se commit JAMAIS.
supabase/import_formules_maitres.sql
